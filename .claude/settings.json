{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh", "timeout": 10 }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          { "type": "command", "command": "date '+TODAY IS %A %d %B %Y (%Y-%m-%d), %H:%M. Use this date, never guess it.'", "timeout": 5 }
        ]
      }
    ]
  }
}
